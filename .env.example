# ─────────────────────────────────────────────────────────────────────────────
# hood-traders configuration. Copy to `.env` and edit. NOTHING here is required
# to run in paper mode — `docker compose up` and `npm run fleet` both work with
# zero config against live mainnet data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Which Robinhood Chain to observe/trade on. mainnet = 4663, testnet = 46630.
HOOD_NETWORK=mainnet
# Optional paid RPC (Alchemy recommended for live trading). Falls back to the
# public RPC baked into viem's chain def when unset.
# HOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Live trading (OFF by default) ────────────────────────────────────────────
# Paper mode is the default and needs none of the below. To trade REAL funds you
# must set HOOD_TRADERS_LIVE=1 AND provide a funded key. Every safeguard below
# still applies in live mode — they are not optional.
HOOD_TRADERS_LIVE=0
# Wallet private key for live/testnet execution. Env var ONLY — never in code.
# ROBINHOOD_CHAIN_PRIVATE_KEY=0x...

# Affirm you are NOT a US/CA/UK/CH person before any Stock Token ACQUISITION.
# Stock Tokens are tokenized debt securities and may not be sold to US persons.
# Leaving this false blocks the premium-watch strategy from buying Stock Tokens
# (it stays alerts-only). Selling and displaying data are never gated.
HOOD_STOCK_TOKEN_ELIGIBLE=false

# ── Global risk rails (apply to the whole fleet) ─────────────────────────────
# Hard ceiling on notional the entire fleet may spend per UTC day, in USDG.
FLEET_MAX_DAILY_SPEND_USDG=250
# Dashboard + kill-switch HTTP server port.
DASHBOARD_PORT=4670
# Path to a file whose existence trips the global kill switch.
KILL_FILE=./KILL

# ── Per-agent risk rails (defaults; overridable per agent in fleet config) ───
AGENT_MAX_POSITION_USDG=50
AGENT_MAX_DAILY_SPEND_USDG=100
AGENT_MAX_SLIPPAGE_BPS=100
AGENT_COOLDOWN_SECONDS=60

# ── llm-strategist (OPTIONAL — the strategy is simply not added to the fleet
# unless BOTH vars below are set). Bring your own key: pick exactly ONE
# provider. Every LLM verdict still passes through the same risk engine as
# every other strategy — an LLM proposes, it never executes directly.
# provider: anthropic | openai | groq | openrouter
HOOD_LLM_PROVIDER=
HOOD_LLM_API_KEY=
# Optional. Falls back to a sane per-provider default when unset (see
# src/framework/llm.ts DEFAULT_MODELS) — set this if that default ever goes
# stale for your provider, or to pick a stronger/cheaper model.
HOOD_LLM_MODEL=
# Minimum LLM-stated confidence (0-1) required to actually place the trade.
HOOD_LLM_MIN_CONFIDENCE=0.6
# Per-call timeout before the judge is treated as failed (skips the candidate).
HOOD_LLM_TIMEOUT_MS=9000

# Optional native Hub launch adapter (reviewed deployment only).
# hub-main reads process environment; it does not load this file automatically.
HUB_LAUNCH_FACTORY=
HUB_LAUNCH_FACTORY_BLOCK=



# ── Hub manual trading asset allowlist (OPTIONAL) ────────────────────────────
# WETH and USDG are enabled by default. To expose additional Robinhood Chain
# ERC-20s in the Hub Trade screen, provide a JSON array of assets reviewed by
# the operator. Discovery alone NEVER makes a launch token tradable.
#
# Stock Tokens are intentionally rejected here; they require wallet-specific
# eligibility and use a separate integration.
#
# Example (single-line JSON):
# HUB_TRADE_ASSETS=[{"address":"0x1234567890123456789012345678901234567890","symbol":"TOKEN","name":"Example Token","decimals":18,"type":"crypto"}]
#
# Allowed types: crypto | stablecoin | launch-token
HUB_TRADE_ASSETS=



# ── Hub operator authentication (OPTIONAL) ───────────────────────────────────
# Persistent credential for paper-strategy start/stop and Hub kill controls.
# Use at least 32 random characters. Keep this SERVER-SIDE only.
#
# The API accepts it as:
#   Authorization: Bearer <token>
#
# /api/status reports only whether operator auth is configured; it never returns
# this credential. X-Hub-Control is disabled when this credential is configured.
# Preview controls remain available only without operator auth. No live bot signing.
#
# Recommended production shape: keep the Hub API on loopback/private network and
# have an authenticated same-origin proxy/admin service inject the bearer token.
# HUB_OPERATOR_TOKEN=

# HUB_LAUNCH_FACTORY_ADDRESS is a legacy alias for HUB_LAUNCH_FACTORY.
# It still requires HUB_LAUNCH_FACTORY_BLOCK; conflicting addresses fail startup.
