# ─────────────────────────────────────────────────────────────────────────────
# hood-traders configuration. Copy to `.env` and edit. NOTHING here is required
# to run in paper mode — `docker compose up` and `npm run fleet` both work with
# zero config against live mainnet data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Which Robinhood Chain to observe/trade on. mainnet = 4663, testnet = 46630.
HOOD_NETWORK=mainnet
# Optional paid RPC (Alchemy recommended for live trading). Falls back to the
# public RPC baked into viem's chain def when unset.
# HOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# Optional comma-separated read fallback endpoints. Fallback is never used to
# retry an ambiguous transaction submission.
# HOOD_RPC_FALLBACK_URLS=https://rpc.example-2,https://rpc.example-3
# Shared transport bounds. Safe/read-only requests may retry/fail over.
HOOD_RPC_MAX_CONCURRENCY=8
HOOD_RPC_READ_RETRIES=1
HOOD_RPC_TIMEOUT_MS=8000

# ── Live trading (OFF by default) ────────────────────────────────────────────
# Paper mode is the default and needs none of the below. To trade REAL funds you
# must set HOOD_TRADERS_LIVE=1 AND provide a funded key. Every safeguard below
# still applies in live mode — they are not optional.
HOOD_TRADERS_LIVE=0
# Wallet private key for live/testnet execution. Env var ONLY — never in code.
# ROBINHOOD_CHAIN_PRIVATE_KEY=0x...

# Deployment-level acknowledgement for Stock Token ACQUISITION.
# Robinhood Chain Stock Tokens are tokenised debt securities issued by
# Robinhood Assets (Jersey) Limited and are subject to jurisdictional restrictions.
# This flag alone is NOT sufficient for Hub manual acquisition: the connected
# wallet must also have a current wallet-scoped external compliance attestation
# in HUB_STOCK_COMPLIANCE_ATTESTATIONS. Selling/display remain separately available.
HOOD_STOCK_TOKEN_ELIGIBLE=false

# Wallet-scoped Stock Token compliance attestations (SERVER-SIDE ONLY).
# Feed these booleans from your external compliance/onboarding process. Do NOT
# place TINs, identity documents, citizenship, tax residence, or other identity
# data here; the parser intentionally rejects unsupported fields.
#
# Timestamps are Unix epoch milliseconds. Each wallet must separately confirm:
# - nonUsPerson
# - jurisdictionEligible (using the current RHJ restricted-jurisdiction terms)
# - appropriatenessPassed
# - riskDisclosuresAccepted
# - taxCertificationComplete
#
# Example:
# HUB_STOCK_COMPLIANCE_ATTESTATIONS=[{"account":"0x1111111111111111111111111111111111111111","nonUsPerson":true,"jurisdictionEligible":true,"appropriatenessPassed":true,"riskDisclosuresAccepted":true,"taxCertificationComplete":true,"verifiedAt":1789786800000,"expiresAt":1792378800000}]
HUB_STOCK_COMPLIANCE_ATTESTATIONS=

# ── Controlled Hub live automation (SEPARATE PROCESS; OFF by default) ────────
# The signerless Hub ignores these. The live automation entrypoint requires all
# activation gates and refuses startup when its hard safety ceilings are exceeded.
# HUB_LIVE_AUTOMATION=I_UNDERSTAND_REAL_FUNDS
# HUB_LIVE_AUTOMATION_AGENTS=momentum-1
# HUB_LIVE_AUTOMATION_DB=./data/live-automation.db
#
# Controlled live automation requires HOOD_TRADERS_LIVE=1 and a dedicated
# ROBINHOOD_CHAIN_PRIVATE_KEY. Use a separately funded wallet. The runner never
# sends ERC-20 approval transactions: approve the canonical router manually with
# the smallest allowance needed before starting a strategy.
#
# Hard runner ceilings:
#   FLEET_MAX_DAILY_SPEND_USDG <= 50
#   AGENT_MAX_DAILY_SPEND_USDG <= 25
#   AGENT_MAX_POSITION_USDG <= 10
#   AGENT_MAX_SLIPPAGE_BPS <= 100
#   AGENT_COOLDOWN_SECONDS >= 60
#
# ── Global risk rails (apply to the whole fleet) ─────────────────────────────
# Hard ceiling on notional the entire fleet may spend per UTC day, in USDG.
FLEET_MAX_DAILY_SPEND_USDG=250
# Dashboard + kill-switch HTTP server port.
DASHBOARD_PORT=4670
# Path to a file whose existence trips the global kill switch.
KILL_FILE=./KILL

# ── Per-agent risk rails (defaults; overridable per agent in fleet config) ───
AGENT_MAX_POSITION_USDG=50
AGENT_MAX_DAILY_SPEND_USDG=100
AGENT_MAX_SLIPPAGE_BPS=100
AGENT_COOLDOWN_SECONDS=60

# ── llm-strategist (OPTIONAL — the strategy is simply not added to the fleet
# unless BOTH vars below are set). Bring your own key: pick exactly ONE
# provider. Every LLM verdict still passes through the same risk engine as
# every other strategy — an LLM proposes, it never executes directly.
# provider: anthropic | openai | groq | openrouter
HOOD_LLM_PROVIDER=
HOOD_LLM_API_KEY=
# Optional. Falls back to a sane per-provider default when unset (see
# src/framework/llm.ts DEFAULT_MODELS) — set this if that default ever goes
# stale for your provider, or to pick a stronger/cheaper model.
HOOD_LLM_MODEL=
# Minimum LLM-stated confidence (0-1) required to actually place the trade.
HOOD_LLM_MIN_CONFIDENCE=0.6
# Per-call timeout before the judge is treated as failed (skips the candidate).
HOOD_LLM_TIMEOUT_MS=9000

# Optional native Hub launch adapter (reviewed deployment only).
# hub-main reads process environment; it does not load this file automatically.
HUB_LAUNCH_FACTORY=
HUB_LAUNCH_FACTORY_BLOCK=
# Parallel V2 factory (undeployed by default). Do not set until deployments/4663-v2.json is verified.
# HUB_LAUNCH_FACTORY_V2=
# HUB_LAUNCH_FACTORY_V2_BLOCK=
# Forever flagship: the ONLY discretionary bucket is the 10% participation pot
# (viewers + social, combined). Holders (55%), streamers (15%), depth (10%), and the
# platform bucket (10%) are fully automatic on-chain and never touch this operator.
# Must be the owner's existing reviewed admin wallet — ideally itself a multisig —
# never an autonomous/hot key. Unset by default (feature stays off).
# HUB_FOREVER_EPOCH_OPERATOR=
# Streaming (vendor C — LiveKit first). Secrets stay on the Docker host.
# HUB_STREAM_PROVIDER=livekit
# HUB_STREAM_TOKEN_SECRET=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
# Optional separate webhook signing secret for POST /api/stream/webhook/livekit; falls
# back to LIVEKIT_API_SECRET if unset. Configure this as LiveKit's webhook URL/secret so
# mediaState reflects real participant/track events, not just optimistic token-mint state.
# LIVEKIT_WEBHOOK_SECRET=



# ── Hub manual trading asset allowlist (OPTIONAL) ────────────────────────────
# WETH and USDG are enabled by default. To expose additional Robinhood Chain
# ERC-20s in the Hub Trade screen, provide a JSON array of assets reviewed by
# the operator. Discovery alone NEVER makes a launch token tradable.
#
# Stock Tokens are intentionally rejected here; they require wallet-specific
# eligibility and use a separate integration.
#
# Example (single-line JSON):
# HUB_TRADE_ASSETS=[{"address":"0x1234567890123456789012345678901234567890","symbol":"TOKEN","name":"Example Token","decimals":18,"type":"crypto"}]
#
# Allowed types: crypto | stablecoin | launch-token
HUB_TRADE_ASSETS=



# ── Hub operator authentication (OPTIONAL) ───────────────────────────────────
# Persistent credential for paper-strategy start/stop and Hub kill controls.
# Use at least 32 random characters. Keep this SERVER-SIDE only.
#
# The API accepts it as:
#   Authorization: Bearer <token>
#
# /api/status reports only whether operator auth is configured; it never returns
# this credential. X-Hub-Control is disabled when this credential is configured.
# Preview controls remain available only without operator auth. No live bot signing.
#
# Recommended production shape: keep the Hub API on loopback/private network and
# have an authenticated same-origin proxy/admin service inject the bearer token.
# HUB_OPERATOR_TOKEN=

# HUB_LAUNCH_FACTORY_ADDRESS is a legacy alias for HUB_LAUNCH_FACTORY.
# It still requires HUB_LAUNCH_FACTORY_BLOCK; conflicting addresses fail startup.

# RPC integer ranges: concurrency 1-32; read retries 0-3; timeout 500-30000 ms.
# Fallback URLs are read-only. Writes/unknown methods use the primary once.
# Stateful filters are unsupported; existing watchers use block-range log polling.
